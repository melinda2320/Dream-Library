# PORT: Port server Express & Vite (default 3000)
PORT=3000

# ADMIN_PASSCODE: Kode akses opsional untuk masuk sebagai Pustakawan/Admin.
# Jika dikosongkan, akun Pustakawan pertama dapat didaftarkan langsung lewat antarmuka web.
ADMIN_PASSCODE=

# APP_URL: URL tempat aplikasi dijalankan (diisi otomatis saat deploy).
APP_URL="MY_APP_URL"
